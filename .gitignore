# =============================================================
# MineChain .gitignore
# Files and folders listed here are NEVER saved by Git.
# Rule of thumb: secrets and generated files stay out of Git.
# =============================================================

# ---------- SECRETS (most important section) ----------
# .env files hold private keys, JWT secrets and database passwords.
# We commit only .env.example, which contains fake placeholder values.
.env
.env.*
!.env.example

# Android signing keys: whoever has these can publish apps as you.
*.jks
*.keystore
key.properties
# Private documents (proposal, notes). Readable locally by Claude Code,
# never pushed to the public repo.
private/

# ---------- Node.js (backend/ and contracts/) ----------
# node_modules is rebuilt from package.json with `npm install`,
# and it is huge, so it never goes into Git.
node_modules/
npm-debug.log*
coverage/

# ---------- Hardhat (contracts/) ----------
# Compiled output, regenerated by `npx hardhat compile`.
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
# Local-network deployment records (chain 31337 = local Hardhat node).
contracts/ignition/deployments/chain-31337/

# ---------- Flutter and Android (mobile/) ----------
# Build output and tool caches, regenerated on every build.
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
# Machine-specific paths (your SDK location), different on every laptop.
local.properties
.gradle/

# ---------- Editors and operating system ----------
.idea/
*.iml
.vscode/
Thumbs.db
.DS_Store
# Claude Code personal settings (local permissions), never shared.
**/.claude/settings.local.json
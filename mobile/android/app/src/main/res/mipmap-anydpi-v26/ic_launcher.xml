<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon (Android 8.0 and later, so every phone the app
     runs on). The phone cuts it to its own shape; the logo stays inside the
     central safe circle, so no shape cuts it.

     The monochrome layer is for Android 13 themed icons: the phone keeps only
     the logo's outline and paints it in the wallpaper's colours, so the same
     drawable serves. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js REST API: JWT authentication, role-based access, transaction processing and anomaly detection.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.js",
    "migrate": "node-pg-migrate up -m migrations -d DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m migrations -d DATABASE_URL",
    "migrate:test": "node-pg-migrate up -m migrations -d TEST_DATABASE_URL",
    "migrate:create": "node-pg-migrate create -m migrations -j sql",
    "seed": "node scripts/seed.js",
    "make:signing-vectors": "node scripts/make-signing-vectors.js",
    "anchor:once": "node scripts/anchor-once.js",
    "demo:journey": "node scripts/demo-journey.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "ethers": "6.17.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

# Why this file exists: under npm 10.9.2, installing vitest 5 crashed npm's peer-dependency
# resolver with "Cannot read properties of null (reading 'edgesOut')". With legacy-peer-deps,
# npm handles peer dependencies the npm 6 way: it does not install or check them
# automatically, and that avoids the crash. Keeping the setting here means a plain
# `npm install` works for everyone, including the Render build.
#
# Trade-off: npm no longer installs required peer dependencies or warns when they are
# missing. That is why `vite`, a required peer of vitest, is listed directly in
# devDependencies. Run `npm ls` after adding a package to spot any others. Try deleting this file after upgrading npm; if `npm install` then
# succeeds without it, it is no longer needed.
legacy-peer-deps=true

# Copy this file to .env and replace every value. .env is git-ignored; this file is not,
# so it must only ever hold fake placeholder values.

NODE_ENV=development
PORT=3000

# Separate databases so running the tests can never wipe development data.
DATABASE_URL=postgresql://minechain_app:change-me@localhost:5432/minechain_dev
TEST_DATABASE_URL=postgresql://minechain_app:change-me@localhost:5432/minechain_test

# At least 43 random characters (256 bits, as HS256 needs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-43-random-characters-xxxxxxxxxxxx

# NFR-01 caps token lifetime at 60 minutes; config validation rejects anything longer.
JWT_EXPIRES_IN=60m

# Number of proxies in front of the API: 0 locally, 1 on Render (planned). Rate limits
# count requests per client IP, which is only correct when this matches.
TRUST_PROXY=0

# Used only by `npm run seed`. The seed refuses any value still starting with
# "replace-with", and both passwords must meet the registration password policy
# (12-128 characters, not common, not containing the username). Never print or share them.
SEED_ADMIN_USERNAME=replace-with-admin-username
SEED_ADMIN_PASSWORD=replace-with-a-long-admin-passphrase
# Optional. When set (and not in production), the seed also creates one active demo user
# per role (seed_miner, seed_transporter, seed_buyer, seed_officer) with this password.
# Leave it empty to skip them.
SEED_DEMO_PASSWORD=replace-with-a-long-demo-passphrase

# --- Anchoring to the MineChain contract on Sepolia (docs/contract-spec.md) ---
# Off by default. While it is false, the settings below may be empty or still hold their
# placeholders, and the API starts without them. Any other value is still checked.
ANCHOR_ENABLED=false

# SECRET. Your provider's Sepolia URL, which usually contains an API key. https only.
SEPOLIA_RPC_URL=https://replace-with-your-sepolia-rpc-url
# SECRET. Optional second provider, used when the first one fails. It must differ from
# SEPOLIA_RPC_URL. Leave it empty for none.
SEPOLIA_RPC_URL_FALLBACK=https://replace-with-a-second-sepolia-rpc-url

# Public, not a secret: the deployed contract, checksummed exactly as Etherscan shows it.
MINECHAIN_CONTRACT_ADDRESS=0x6419cB5268706E2aA4713AB3bCFc336248Ed158a

# SECRET. The private key of the throwaway RECORDER wallet only (the one holding
# RECORDER_ROLE), 0x followed by 64 hex characters. Never the deployer or admin key, and
# never a wallet that has held real funds. Never print, log or share it.
RECORDER_PRIVATE_KEY=replace-with-0x-and-64-hex-characters

# Must be 11155111 (Sepolia). Checked against the RPC provider at startup.
CHAIN_ID=11155111
# Seconds between anchoring rounds (5 to 3600).
ANCHOR_INTERVAL_SECONDS=30
# Blocks to wait after a step is mined before it counts as confirmed (1 to 12).
ANCHOR_CONFIRMATIONS=2
# Sends per step before it is marked failed (1 to 20). RPC outages do not count.
ANCHOR_MAX_ATTEMPTS=5
# Warn when the recorder wallet holds less than this, in ETH. 0 turns the warning off.
ANCHOR_LOW_BALANCE_ETH=0.002
# Do not send while Sepolia's fee per gas is above this, in gwei.
ANCHOR_MAX_FEE_GWEI=50
